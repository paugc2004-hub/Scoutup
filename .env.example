# ScoutUp Club · variables de entorno (todas opcionales en local). Nunca subas un .env real.

# Ruta del fichero SQLite (por defecto: data/scoutup-demo.db)
# SCOUTUP_DB=data/scoutup-demo.db

# Acceso rápido con usuarios de demo (/api/auth/demo) y «Simular respuesta del jugador».
# Pon "off" en un entorno que no sea de demostración.
# SCOUTUP_DEMO_LOGIN=on

# Solo para servir la versión de producción por HTTP sin TLS (p. ej. pruebas E2E locales).
# En producción real NO lo actives: las cookies de sesión deben ser Secure.
# SCOUTUP_INSECURE_COOKIES=1

# Rate limiting en memoria (on por defecto). "off" solo para depurar.
# SCOUTUP_RATE_LIMIT=on

# Nivel de log: info (defecto), debug o silent
# SCOUTUP_LOG=info

# Proveedor de datos de competición (solo existe "mock")
# COMPETITION_PROVIDER=mock
