{
  "name": "scoutup-demo",
  "version": "1.0.0",
  "private": true,
  "description": "ScoutUp — demo interactiva full-stack (dades fictícies)",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "seed": "node --experimental-strip-types --no-warnings scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "demo": "next build && next start -p 3100",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.1.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.4",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "postcss": "^8.5.28"
  }
}
